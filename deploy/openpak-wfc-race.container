[Unit]
Description=OpenPak WFC race
After=openpak-postgres.service

[Container]
ContainerName=openpak-wfc-race
Image=ghcr.io/openpak/wfc-race:latest
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/wfc-full/wfc-race.env
Volume=%h/openpak/deploy/wfc-split/token.key:/keys/wfc-token.key:ro,U

[Service]
Restart=always

[Install]
WantedBy=default.target
